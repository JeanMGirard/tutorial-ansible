{
  "ansible.python.interpreterPath": "python",
  "ansible.ansible.useFullyQualifiedCollectionNames": true,
  "ansible.lint.arguments": "-p",
  "editor.formatOnSave": true,
  "files.associations": {
    "*.yml": "yaml",
    "*.yaml": "yaml",
    "ansible.cfg": "ini"
  },
  "yaml.customTags": ["!vault scalar", "!unsafe"],
  "yaml.format.enable": true,
  "yaml.validate": true,
  "files.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/.idea": true,
    "**/node_modules": true,
    "Makefile": true,
    ".gitattributes": true,
    ".gitmodules": true,
    ".mardownlint.json": true,
    ".pre-commit-config.yaml": true,
    ".yamllint.yml": true,
    "infra/.terraform": true,
    "**/*.tfstate*": true,
    "**/*.lock.*": true,
    "**/.cache": true
  }
}
